<span class="w">      </span><span class="n">Node234</span><span class="o">*</span><span class="w"> </span><span class="n">next</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">node</span><span class="o">-&gt;</span><span class="n">NextNode</span><span class="p">(</span><span class="n">existing</span><span class="p">);</span>
