<assessmentItem xmlns="http://www.imsglobal.org/xsd/imsqti_v2p1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqti_v2p1 http://www.imsglobal.org/xsd/qti/qtiv2p1/imsqti_v2p1p1.xsd" identifier="VE_IP_8" title="Question 8" adaptive="false" timeDependent="false"><responseDeclaration identifier="RESPONSE" cardinality="single" baseType="identifier"><correctResponse><value>a</value></correctResponse></responseDeclaration><outcomeDeclaration identifier="SCORE" cardinality="single" baseType="float" normalMaximum="1" normalMinimum="0"><defaultValue><value>0</value></defaultValue></outcomeDeclaration><itemBody><div><p>Which statement replaces XXX to complete the Graph class's DepthFirstSearch() member function?</p><p><code><div class="highlight"><pre><span /><span class="kt">void</span><span class="w"> </span><span class="nf">DepthFirstSearch</span><span class="p">(</span><span class="n">Vertex</span><span class="o">*</span><span class="w"> </span><span class="n">startVertex</span><span class="p">,</span><span class="w"> </span><span class="n">VertexVisitor</span><span class="o">&amp;</span><span class="w"> </span><span class="n">visitor</span><span class="p">)</span><span class="w"> </span><span class="p">{</span>
<span class="w">   </span><span class="k">using</span><span class="w"> </span><span class="k">namespace</span><span class="w"> </span><span class="nn">std</span><span class="p">;</span>
<span class="w">   </span><span class="n">stack</span><span class="o">&lt;</span><span class="n">Vertex</span><span class="o">*&gt;</span><span class="w"> </span><span class="n">vertexStack</span><span class="p">;</span>
<span class="w">   </span><span class="n">unordered_set</span><span class="o">&lt;</span><span class="n">Vertex</span><span class="o">*&gt;</span><span class="w"> </span><span class="n">visitedSet</span><span class="p">;</span>
<span class="w">   </span><span class="n">vertexStack</span><span class="p">.</span><span class="n">push</span><span class="p">(</span><span class="n">startVertex</span><span class="p">);</span>
<span class="w">   </span><span class="k">while</span><span class="w"> </span><span class="p">(</span><span class="n">vertexStack</span><span class="p">.</span><span class="n">size</span><span class="p">()</span><span class="w"> </span><span class="o">&gt;</span><span class="w"> </span><span class="mi">0</span><span class="p">)</span><span class="w"> </span><span class="p">{</span>
<span class="w">      </span><span class="n">Vertex</span><span class="o">*</span><span class="w"> </span><span class="n">currentVertex</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="n">vertexStack</span><span class="p">.</span><span class="n">top</span><span class="p">();</span>
<span class="w">      </span><span class="n">vertexStack</span><span class="p">.</span><span class="n">pop</span><span class="p">();</span>
<span class="w">      </span><span class="k">if</span><span class="w"> </span><span class="p">(</span><span class="mi">0</span><span class="w"> </span><span class="o">==</span><span class="w"> </span><span class="n">visitedSet</span><span class="p">.</span><span class="n">count</span><span class="p">(</span><span class="n">currentVertex</span><span class="p">))</span><span class="w"> </span><span class="p">{</span>
<span class="w">         </span><span class="n">visitor</span><span class="p">.</span><span class="n">Visit</span><span class="p">(</span><span class="n">currentVertex</span><span class="p">);</span>
<span class="w">         </span><span class="n">visitedSet</span><span class="p">.</span><span class="n">insert</span><span class="p">(</span><span class="n">currentVertex</span><span class="p">);</span>
<span class="w">         </span><span class="k">for</span><span class="w"> </span><span class="p">(</span><span class="n">Edge</span><span class="o">*</span><span class="w"> </span><span class="n">edge</span><span class="w"> </span><span class="o">:</span><span class="w"> </span><span class="o">*</span><span class="n">GetEdgesFrom</span><span class="p">(</span><span class="n">currentVertex</span><span class="p">))</span><span class="w"> </span><span class="p">{</span>
<span class="w">            </span><span class="n">XXX</span>
<span class="w">         </span><span class="p">}</span>
<span class="w">      </span><span class="p">}</span>
<span class="w">   </span><span class="p">}</span>
<span class="p">}</span>
</pre></div></code></p></div><choiceInteraction responseIdentifier="RESPONSE" shuffle="false" maxChoices="1" minChoices="0"><simpleChoice identifier="a" showHide="show" fixed="true"><div><p><code>vertexStack.push(edge-&gt;toVertex);</code></p></div></simpleChoice><simpleChoice identifier="b" showHide="show" fixed="true"><div><p><code>currentVertex = edge-&gt;toVertex;</code></p></div></simpleChoice><simpleChoice identifier="c" showHide="show" fixed="true"><div><p><code>vertexStack.push(edge-&gt;fromVertex);</code></p></div></simpleChoice><simpleChoice identifier="d" showHide="show" fixed="true"><div><p><code>currentVertex = edge-&gt;fromVertex;</code></p></div></simpleChoice></choiceInteraction></itemBody><responseProcessing template="http://www.imsglobal.org/question/qti_v2p1/rptemplates/match_correct" /></assessmentItem>