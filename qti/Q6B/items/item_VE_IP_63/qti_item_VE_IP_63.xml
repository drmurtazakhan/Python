</pre></div></code></p></div><choiceInteraction responseIdentifier="RESPONSE" shuffle="false" maxChoices="1" minChoices="0"><simpleChoice identifier="a" showHide="show" fixed="true"><div><p><code>toEdges[fromVertex]-&gt;push_back(newEdge);</code></p></div></simpleChoice><simpleChoice identifier="b" showHide="show" fixed="true"><div><p><code>fromEdges[fromVertex]-&gt;push_back(newEdge);</code></p></div></simpleChoice><simpleChoice identifier="c" showHide="show" fixed="true"><div><p><code>toEdges[toVertex]-&gt;push_back(newEdge);</code></p></div></simpleChoice><simpleChoice identifier="d" showHide="show" fixed="true"><div><p><code>fromEdges[toVertex]-&gt;push_back(newEdge);</code></p></div></simpleChoice></choiceInteraction></itemBody><responseProcessing template="http://www.imsglobal.org/question/qti_v2p1/rptemplates/match_correct" /></assessmentItem>